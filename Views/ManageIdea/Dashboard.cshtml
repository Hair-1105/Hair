@model HanaMedia.ViewModels.IdeaDashboardViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HanaMedia — Dashboard Quản lý Ý tưởng</title>
  <link rel="stylesheet" href="~/css/tabler-icons/tabler-icons.min.css">
  <link rel="stylesheet" href="~/css/design-system.css">
  <link rel="stylesheet" href="~/css/layout.css">
  <link rel="stylesheet" href="~/css/components.css">
</head>
<body>
<div class="layout">

  <partial name="_SidebarPartial" />


  <main class="main">
    <div class="topbar">
      <div>
        <div class="page-title">Dashboard Phòng Sáng tạo / Ý tưởng</div>
        <div class="page-sub">Chi tiết vòng đời phát triển ý tưởng, kịch bản Booking và tiến độ công việc của các Copywriter</div>
      </div>
    </div>

    <!-- KPI GRID (5 CARD / ROW ON DESKTOP) -->
    <div class="kpi-grid">
      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Ý tưởng bản nháp</div>
          <div class="kpi-icon" style="background:var(--blue-100); color:var(--blue-700);"><i class="ti ti-bulb"></i></div>
        </div>
        <div class="kpi-value">@Model.NewIdeas</div>
        <div class="kpi-note">Chưa gửi review</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Ý tưởng đang review</div>
          <div class="kpi-icon" style="background:var(--amber-bg); color:var(--amber);"><i class="ti ti-eye"></i></div>
        </div>
        <div class="kpi-value">@Model.Review</div>
        <div class="kpi-note">Đang xem xét kịch bản/concept</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Cần chỉnh sửa</div>
          <div class="kpi-icon" style="background:var(--red-bg); color:var(--red);"><i class="ti ti-edit"></i></div>
        </div>
        <div class="kpi-value">@Model.NeedRevision</div>
        <div class="kpi-note">Đã gửi phản hồi yêu cầu sửa</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Ý tưởng đã duyệt</div>
          <div class="kpi-icon" style="background:var(--green-bg); color:var(--green);"><i class="ti ti-circle-check"></i></div>
        </div>
        <div class="kpi-value">@Model.Approved</div>
        <div class="kpi-note">Quản lý đã duyệt, chưa triển khai</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Đang triển khai</div>
          <div class="kpi-icon" style="background:var(--blue-100); color:var(--blue-700);"><i class="ti ti-rocket"></i></div>
        </div>
        <div class="kpi-value">@Model.InProgress</div>
        <div class="kpi-note">Chuyển giao cho team sản xuất</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Ý tưởng hoàn thành</div>
          <div class="kpi-icon" style="background:var(--green-bg); color:var(--green);"><i class="ti ti-award"></i></div>
        </div>
        <div class="kpi-value">@Model.Done</div>
        <div class="kpi-note">Đã hoàn thành triển khai</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Công việc quá hạn</div>
          <div class="kpi-icon" style="background:var(--red-bg); color:var(--red);"><i class="ti ti-alert-triangle"></i></div>
        </div>
        <div class="kpi-value">@Model.OverdueTasks</div>
        <div class="kpi-delta down"><i class="ti ti-arrow-down-right"></i>Cần nhắc deadline</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Tỷ lệ hoàn thành công việc</div>
          <div class="kpi-icon" style="background:var(--green-bg); color:var(--green);"><i class="ti ti-chart-bar"></i></div>
        </div>
        <div class="kpi-value">@(Model.CompletionPercent)%</div>
        <div class="kpi-note">@Model.CompletedTasks / @Model.TotalTasks công việc, toàn thời gian</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Booking đang chạy</div>
          <div class="kpi-icon" style="background:var(--blue-100); color:var(--blue-700);"><i class="ti ti-rocket"></i></div>
        </div>
        <div class="kpi-value">@Model.RunningCampaigns</div>
        <div class="kpi-note">Đã được Giám đốc duyệt</div>
      </div>

      <div class="kpi-card">
        <div class="kpi-top">
          <div class="kpi-label">Ý tưởng chờ Giám đốc duyệt</div>
          <div class="kpi-icon" style="background:var(--amber-bg); color:var(--amber);"><i class="ti ti-checklist"></i></div>
        </div>
        <div class="kpi-value">@Model.PendingDirector</div>
        <div class="kpi-note">Theo trạng thái duyệt của Giám đốc</div>
      </div>
    </div>

    <div class="grid-2">
      <div class="card">
        <div class="card-head">
          <div class="card-title">Tiến độ công việc nhân sự phòng Ý tưởng</div>
        </div>
        <div style="overflow-x:auto;"><table>
          <thead>
            <tr>
              <th>Nhân viên</th>
              <th>Chưa hoàn thành</th>
              <th>Đã hoàn thành</th>
              <th>Tỷ lệ hoàn thành</th>
              <th>Trạng thái</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var employee in Model.Employees)
            {
              var statusLabel = employee.Status switch { "dang_lam_viec" => "Đang làm việc", "thu_viec" => "Thử việc", "cho_duyet_nghi" => "Chờ duyệt nghỉ", "da_nghi" => "Đã nghỉ", _ => employee.Status };
              <tr>
                <td><strong>@employee.Name</strong></td>
                <td>@employee.OpenTasks</td><td>@employee.DoneTasks</td>
                <td><span class="bar-mini"><span class="bar-mini-fill" style="width:@(employee.CompletionPercent)%"></span></span>@(employee.CompletionPercent)%</td>
                <td><span class="status-chip">@statusLabel</span></td>
              </tr>
            }
            @if (Model.Employees.Count == 0)
            {
              <tr><td colspan="5">Chưa có nhân sự phòng Ý tưởng hoặc nhân sự được giao việc ý tưởng.</td></tr>
            }
          </tbody>
        </table></div>
      </div>

      <div class="card">
        <div class="card-head">
          <div class="card-title">Tỉ lệ trạng thái ý tưởng</div>
        </div>
        <div style="position:relative; height:200px; margin-bottom:12px;">
          <canvas id="ideaStatusChart"></canvas>
        </div>
        <div class="legend" style="justify-content:space-between; gap:10px 16px; font-size:12px;">
          <span><i style="background:#94A3B8"></i>Bản nháp (@Model.NewIdeas)</span>
          <span><i style="background:#8AB8F2"></i>Review (@Model.Review)</span>
          <span><i style="background:#F59E0B"></i>Cần sửa (@Model.NeedRevision)</span>
          <span><i style="background:#2F80ED"></i>Đã duyệt (@Model.Approved)</span>
          <span><i style="background:#1CA36B"></i>Đang triển khai (@Model.InProgress)</span>
          <span><i style="background:#14B8A6"></i>Hoàn thành (@Model.Done)</span>
        </div>
      </div>
    </div>

  </main>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
const ideaCtx = document.getElementById('ideaStatusChart');
if (typeof Chart !== 'undefined') new Chart(ideaCtx, {
  type: 'doughnut',
  data: {
    labels: ['Bản nháp','Review','Cần sửa','Đã duyệt','Đang triển khai','Hoàn thành'],
    datasets: [{
      data: @Json.Serialize(new[] { Model.NewIdeas, Model.Review, Model.NeedRevision, Model.Approved, Model.InProgress, Model.Done }),
      backgroundColor: ['#94A3B8','#8AB8F2','#F59E0B','#2F80ED','#1CA36B','#14B8A6'],
      borderColor:'#fff', borderWidth:2
    }]
  },
  options: {
    responsive:true, maintainAspectRatio:false, cutout:'68%',
    plugins:{ legend:{ display:false } }
  }
});
</script>
</body>
</html>
