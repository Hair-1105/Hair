@model List<HanaMedia.Models.Booking>
@using HanaMedia.Controllers
@using HanaMedia.Constants
@using System.Globalization
@{ Layout = "_OperationsLayout"; ViewData["Title"] = "Đối soát tài chính"; ViewData["Subtitle"] = "Theo dõi doanh thu và các khoản chi của Booking đã nhận đủ tiền khách."; var canEdit = User.IsInRole(AppRoles.Director); }
@section PageActions { <a class="ops-button" href="/Accounting/Export?period=@ViewBag.Period&date=@ViewBag.Date"><i class="ti ti-download" aria-hidden="true"></i> Xuất CSV</a> }
<form method="get" class="card ops-card ops-filters">
  <label>Kỳ báo cáo<select name="period"><option value="day" selected="@(ViewBag.Period == "day")">Ngày</option><option value="month" selected="@(ViewBag.Period == "month")">Tháng</option><option value="quarter" selected="@(ViewBag.Period == "quarter")">Quý</option></select></label>
  <label>Ngày trong kỳ<input type="date" name="date" value="@ViewBag.Date" required></label><button class="ops-button primary">Xem báo cáo</button>
</form>
<section class="ops-metrics five">
  @foreach (var metric in new[] { ("Doanh thu", Model.Sum(b => b.BookingPrice)), ("Chi phí", Model.Sum(b => b.ActualCost)), ("Lợi nhuận", Model.Sum(b => b.BookingPrice - b.ActualCost)), ("Cát-xê", Model.Sum(b => b.CastPool)), ("Hoa hồng", Model.Sum(b => b.CommissionPool)) })
  { <div class="kpi-card"><div class="kpi-label">@metric.Item1</div><div class="kpi-value">@metric.Item2.ToString("N0") đ</div><div class="kpi-note">Theo ngày khách thanh toán thực tế</div></div> }
</section>
@if (Model.Any(b => b.FinanceVersion == 0)) { <div class="ops-notice">Dữ liệu lịch sử giữ nguyên số tiền cũ; chỉ hồ sơ đã có tỷ lệ phân bổ mới được tính quỹ cát-xê và hoa hồng.</div> }
<div class="card-head"><h2 class="card-title">Booking trong kỳ</h2><span class="ops-badge neutral">@Model.Count Booking</span></div>
@if (Model.Count == 0) { <div class="card ops-empty">Không có Booking đã nhận đủ tiền trong kỳ này.</div> }
@foreach (var b in Model)
{
  <details class="card ops-card">
    <summary class="ops-summary"><div><h3>#@b.Id — @b.CampaignName</h3><span class="ops-sub">@b.ClientName · Thanh toán @((b.CustomerPaymentDate ?? b.CustomerPaidAt)?.ToString("dd/MM/yyyy"))</span></div><span class="ops-badge success">@b.BookingPrice.ToString("N0") đ <i class="ti ti-chevron-down" aria-hidden="true"></i></span></summary>
    <div class="card-head"><p class="ops-muted">Chi phí @b.ActualCost.ToString("N0") đ · Lợi nhuận @((b.BookingPrice - b.ActualCost).ToString("N0")) đ</p><a class="ops-link" href="/Bookings/Details/@b.Id">Xem toàn bộ Booking →</a></div>
    @if (b.FinanceVersion == 0) { <p class="ops-muted">Hồ sơ lịch sử chưa có phân bổ để đối soát.</p> }
    else
    {
      <div class="ops-table-wrap"><table class="ops-table"><thead><tr><th>Khoản chi</th><th>Người nhận</th><th class="ops-num">Số tiền</th><th>Trạng thái chi trả</th></tr></thead><tbody>
      @foreach (var p in BookingPayables.For(b))
      {
        <tr><td>@(p.Kind == "cast" ? "Cát-xê KOL" : p.Kind == "manager" ? "Hoa hồng phụ trách" : "Hoa hồng nhân viên")</td><td>@p.Name</td><td class="ops-num">@p.Amount.ToString("#,0.##") đ</td><td><span class="ops-badge @(p.Paid ? "success" : "warning")">@(p.Paid ? "Đã thanh toán" : "Chưa thanh toán")</span>
        @if (canEdit && p.Amount > 0) { <form method="post" action="/Accounting/Payment/@b.Id">@Html.AntiForgeryToken()<input type="hidden" name="kind" value="@p.Kind"><input type="hidden" name="payeeId" value="@p.PayeeId"><input type="hidden" name="paid" value="@((!p.Paid).ToString().ToLowerInvariant())"><input type="hidden" name="amount" value="@p.Amount.ToString(CultureInfo.InvariantCulture)"><button class="ops-button">@(p.Paid ? "Đánh dấu chưa thanh toán" : "Xác nhận đã thanh toán")</button></form> }</td></tr>
      }
      </tbody></table></div>
    }
  </details>
}
